<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 o anterior: qué datos entran en el respaldo automático.
    Se excluye todo, igual que en data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
