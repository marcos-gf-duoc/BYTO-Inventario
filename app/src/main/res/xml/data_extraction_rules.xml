<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 o superior: qué datos se pueden copiar a la nube o a otro teléfono.
    Se excluye todo: el inventario (base de datos de Room) queda solo en este teléfono.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
